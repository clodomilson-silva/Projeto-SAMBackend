generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PSICOLOGA_EDUCACIONAL
  SUPERVISAO
  GESTAO
  PROFESSOR
}

enum UserStatus {
  PENDENTE
  AUTORIZADO
  BLOQUEADO
}

enum WorkUnit {
  NUTEC
  CEP_SAO_LUIS
  PA_COHAB
  TIMON
  BALSAS
  CAXIAS
  SANTA_INES
  IMPERATRIZ
  ACAILANDIA
  BACABAL
  PINHEIRO
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  role            UserRole
  crp             String?       @unique
  workUnit        WorkUnit?     @map("work_unit")
  allowedUnits    WorkUnit[]    @default([]) @map("allowed_units")
  passwordHash    String        @map("password_hash")
  active          Boolean       @default(false)
  status          UserStatus    @default(PENDENTE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  resetRequested  Boolean       @default(false) @map("reset_requested")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  authSessions    AuthSession[]
  attendanceNotes AttendanceNote[]

  @@map("users")
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AttendanceNote {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  requestId    String   @map("request_id")
  title        String
  description  String
  optionTags   String[] @default([]) @map("option_tags")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@map("attendance_notes")
}
